# Defaults are deliberately bounded for a small, single-server beta.
DATA_DIR=/data
CONVERSION_WORKERS=2
QUEUE_LIMIT=12
MAX_DURATION_SECONDS=600
RETENTION_SECONDS=1800
MAX_JOB_MB=250
MAX_STORAGE_MB=2048
MONTHLY_DOWNLOAD_GB=100
DAILY_JOB_LIMIT=100
JOBS_PER_IP_PER_HOUR=6
# When using Docker behind a host reverse proxy, set this to the actual Docker
# gateway IP. Direct hosting behind a local proxy uses 127.0.0.1.
TRUSTED_PROXY_IPS=127.0.0.1
# Comma-separated exact frontend origins if using a separate frontend host.
# ALLOWED_ORIGINS=https://your-frontend.example
